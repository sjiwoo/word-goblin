    { "name": "Chinese", "short_name": "中文", "url": "./#/chinese", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Settings", "short_name": "Settings", "url": "./#/settings" }
  ]
